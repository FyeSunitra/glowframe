generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended

  @@map("user_status")
}

enum VerificationStatus {
  pending
  approved
  rejected

  @@map("verification_status")
}

enum ProductStatus {
  draft
  pending
  approved
  rejected
  hidden
  archived

  @@map("product_status")
}

enum MediaType {
  image
  video

  @@map("media_type")
}

enum BookingStatus {
  pendingPayment       @map("pending_payment")
  pendingPaymentReview @map("pending_payment_review")
  paymentRejected      @map("payment_rejected")
  paymentApproved      @map("payment_approved")
  preparing
  readyForPickup       @map("ready_for_pickup")
  shipped
  active
  returnPending        @map("return_pending")
  completed
  cancelled
  expired
  deliveryIssue        @map("delivery_issue")
  disputed

  @@map("booking_status")
}

enum DeliveryMethod {
  pickup
  messenger
  shipping

  @@map("delivery_method")
}

enum PaymentStatus {
  pendingEvidence @map("pending_evidence")
  pendingReview   @map("pending_review")
  approved
  rejected
  refunded

  @@map("payment_status")
}

enum WalletEntryType {
  rentalIncome    @map("rental_income")
  refund
  depositReturn   @map("deposit_return")
  damageDeduction @map("damage_deduction")
  withdrawal
  adminAdjustment @map("admin_adjustment")

  @@map("wallet_entry_type")
}

enum WithdrawalStatus {
  pending
  approved
  rejected
  cancelled

  @@map("withdrawal_status")
}

enum ReturnStatus {
  pending
  renterReturned @map("renter_returned")
  ownerReceived  @map("owner_received")
  damageReported @map("damage_reported")
  completed
  disputed

  @@map("return_status")
}

enum PolicyDocumentType {
  termsOfService              @map("terms_of_service")
  privacyPolicy               @map("privacy_policy")
  rentalAgreement             @map("rental_agreement")
  listingPolicy               @map("listing_policy")
  paymentPolicy               @map("payment_policy")
  identityVerificationConsent @map("identity_verification_consent")

  @@map("policy_document_type")
}

enum PolicyDocumentStatus {
  draft
  current
  superseded
  archived

  @@map("policy_document_status")
}

model User {
  id                   BigInt     @id @default(autoincrement())
  authUserId           String?    @unique @map("auth_user_id") @db.Uuid
  email                String     @unique @db.VarChar(255)
  displayName          String     @map("display_name") @db.VarChar(120)
  fullName             String?    @map("full_name") @db.VarChar(160)
  phone                String?    @db.VarChar(40)
  profileImageUrl      String?    @map("profile_image_url")
  profileImagePublicId String?    @map("profile_image_public_id")
  role                 UserRole   @default(user)
  status               UserStatus @default(active)
  emailVerifiedAt      DateTime?  @map("email_verified_at") @db.Timestamptz
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  emailOtps             EmailOtp[]
  addresses             UserAddress[]
  identityVerifications IdentityVerification[] @relation("IdentityVerificationUser")
  reviewedIdentities    IdentityVerification[] @relation("IdentityVerificationReviewer")
  ownedProducts         Product[]              @relation("ProductOwner")
  approvedProducts      Product[]              @relation("ProductApprover")
  rentedBookings        Booking[]              @relation("BookingRenter")
  ownedBookings         Booking[]              @relation("BookingOwner")
  payments              Payment[]              @relation("PaymentPayer")
  reviewedPayments      Payment[]              @relation("PaymentReviewer")
  reviewedReturns       RentalReturn[]         @relation("RentalReturnReviewer")
  wallet                Wallet?
  bankAccounts          BankAccount[]
  withdrawals           Withdrawal[]           @relation("WithdrawalUser")
  reviewedWithdrawals   Withdrawal[]           @relation("WithdrawalReviewer")
  reviews               Review[]
  notifications         Notification[]
  policyAcceptances     UserPolicyAcceptance[]

  @@index([email])
  @@index([authUserId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model EmailOtp {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt?   @map("user_id")
  email      String    @db.VarChar(255)
  otpHash    String    @map("otp_hash") @db.VarChar(255)
  purpose    String    @db.VarChar(40)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
  @@map("email_otps")
}

model UserAddress {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  label          String   @db.VarChar(80)
  recipientName  String   @map("recipient_name") @db.VarChar(160)
  recipientPhone String   @map("recipient_phone") @db.VarChar(40)
  addressLine    String   @map("address_line")
  province       String   @db.VarChar(120)
  district       String?  @db.VarChar(120)
  subdistrict    String?  @db.VarChar(120)
  postalCode     String?  @map("postal_code") @db.VarChar(20)
  landmark       String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user           User      @relation(fields: [userId], references: [id])
  pickupProducts Product[]

  @@index([userId])
  @@index([isDefault])
  @@map("user_addresses")
}

model IdentityVerification {
  id                  BigInt             @id @default(autoincrement())
  userId              BigInt             @map("user_id")
  legalName           String             @map("legal_name") @db.VarChar(160)
  documentStoragePath String             @map("document_url")
  status              VerificationStatus @default(pending)
  rejectionReason     String?            @map("rejection_reason")
  reviewedBy          BigInt?            @map("reviewed_by")
  reviewedAt          DateTime?          @map("reviewed_at") @db.Timestamptz
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user     User  @relation("IdentityVerificationUser", fields: [userId], references: [id])
  reviewer User? @relation("IdentityVerificationReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([reviewedBy])
  @@map("identity_verifications")
}

model CameraCategory {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  products Product[]

  @@map("camera_categories")
}

model Brand {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  products Product[]

  @@map("brands")
}

model Accessory {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  products ProductAccessory[]

  @@map("accessories")
}

model Product {
  id              BigInt        @id @default(autoincrement())
  ownerId         BigInt        @map("owner_id")
  categoryId      BigInt        @map("category_id")
  brandId         BigInt?       @map("brand_id")
  customBrandName String?       @map("custom_brand_name") @db.VarChar(120)
  pickupAddressId BigInt        @map("pickup_address_id")
  title           String        @db.VarChar(160)
  model           String        @db.VarChar(160)
  serialNumber    String?       @map("serial_number") @db.VarChar(160)
  description     String?
  conditionNote   String?       @map("condition_note")
  extraDetails    String?       @map("extra_details")
  pricePerDay     Decimal       @map("price_per_day") @db.Decimal(12, 2)
  depositAmount   Decimal       @map("deposit_amount") @db.Decimal(12, 2)
  allowPickup     Boolean       @default(true) @map("allow_pickup")
  allowMessenger  Boolean       @default(false) @map("allow_messenger")
  allowShipping   Boolean       @default(false) @map("allow_shipping")
  status          ProductStatus @default(draft)
  rejectionReason String?       @map("rejection_reason")
  approvedBy      BigInt?       @map("approved_by")
  approvedAt      DateTime?     @map("approved_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  owner             User                     @relation("ProductOwner", fields: [ownerId], references: [id])
  category          CameraCategory           @relation(fields: [categoryId], references: [id])
  brand             Brand?                   @relation(fields: [brandId], references: [id])
  pickupAddress     UserAddress              @relation(fields: [pickupAddressId], references: [id])
  approver          User?                    @relation("ProductApprover", fields: [approvedBy], references: [id])
  media             ProductMedia[]
  accessories       ProductAccessory[]
  customAccessories ProductCustomAccessory[]
  bookings          Booking[]
  reviews           Review[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductMedia {
  id        BigInt    @id @default(autoincrement())
  productId BigInt    @map("product_id")
  mediaType MediaType @map("media_type")
  url       String
  publicId  String?   @map("public_id")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([mediaType])
  @@map("product_media")
}

model ProductAccessory {
  productId   BigInt @map("product_id")
  accessoryId BigInt @map("accessory_id")
  quantity    Int    @default(1)

  product   Product   @relation(fields: [productId], references: [id])
  accessory Accessory @relation(fields: [accessoryId], references: [id])

  @@id([productId, accessoryId])
  @@map("product_accessories")
}

model ProductCustomAccessory {
  id        BigInt @id @default(autoincrement())
  productId BigInt @map("product_id")
  name      String @db.VarChar(120)
  quantity  Int    @default(1)
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@map("product_custom_accessories")
}

model Booking {
  id                      BigInt         @id @default(autoincrement())
  bookingNo               String         @unique @map("booking_no") @db.VarChar(32)
  productId               BigInt         @map("product_id")
  renterId                BigInt         @map("renter_id")
  ownerId                 BigInt         @map("owner_id")
  status                  BookingStatus  @default(pendingPayment)
  startDate               DateTime       @map("start_date") @db.Date
  endDate                 DateTime       @map("end_date") @db.Date
  rentalDays              Int            @map("rental_days")
  deliveryMethod          DeliveryMethod @map("delivery_method")
  deliveryFee             Decimal        @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  productPriceSnapshot    Decimal        @map("product_price_snapshot") @db.Decimal(12, 2)
  depositSnapshot         Decimal        @map("deposit_snapshot") @db.Decimal(12, 2)
  rentalFee               Decimal        @map("rental_fee") @db.Decimal(12, 2)
  totalAmount             Decimal        @map("total_amount") @db.Decimal(12, 2)
  recipientName           String?        @map("recipient_name") @db.VarChar(160)
  recipientPhone          String?        @map("recipient_phone") @db.VarChar(40)
  deliveryAddressSnapshot String?        @map("delivery_address_snapshot")
  pickupAddressSnapshot   String?        @map("pickup_address_snapshot")
  deliveryNote            String?        @map("delivery_note")
  paymentDeadlineAt       DateTime?      @map("payment_deadline_at") @db.Timestamptz
  confirmedAt             DateTime?      @map("confirmed_at") @db.Timestamptz
  completedAt             DateTime?      @map("completed_at") @db.Timestamptz
  cancellationReason      String?        @map("cancellation_reason")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  product       Product       @relation(fields: [productId], references: [id])
  renter        User          @relation("BookingRenter", fields: [renterId], references: [id])
  owner         User          @relation("BookingOwner", fields: [ownerId], references: [id])
  payments      Payment[]
  delivery      Delivery?
  rentalReturn  RentalReturn?
  walletEntries WalletEntry[]
  review        Review?

  @@index([bookingNo])
  @@index([productId])
  @@index([renterId])
  @@index([ownerId])
  @@index([status])
  @@index([productId, startDate, endDate])
  @@map("bookings")
}

model Payment {
  id                       BigInt        @id @default(autoincrement())
  bookingId                BigInt        @map("booking_id")
  payerId                  BigInt        @map("payer_id")
  platformPaymentAccountId BigInt?       @map("platform_payment_account_id")
  attemptNo                Int           @default(1) @map("attempt_no")
  status                   PaymentStatus @default(pendingReview)
  proofStoragePath         String?       @map("proof_url")
  proofFileName            String?       @map("proof_file_name") @db.VarChar(255)
  submittedAmount          Decimal?      @map("submitted_amount") @db.Decimal(12, 2)
  submittedAt              DateTime?     @map("submitted_at") @db.Timestamptz
  reviewedBy               BigInt?       @map("reviewed_by")
  reviewedAt               DateTime?     @map("reviewed_at") @db.Timestamptz
  rejectionReason          String?       @map("rejection_reason")
  platformHeldAmount       Decimal       @default(0) @map("platform_held_amount") @db.Decimal(12, 2)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  booking                Booking                 @relation(fields: [bookingId], references: [id])
  payer                  User                    @relation("PaymentPayer", fields: [payerId], references: [id])
  reviewer               User?                   @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  platformPaymentAccount PlatformPaymentAccount? @relation(fields: [platformPaymentAccountId], references: [id], onDelete: SetNull)

  @@unique([bookingId, attemptNo])
  @@index([bookingId])
  @@index([platformPaymentAccountId])
  @@index([status])
  @@index([payerId])
  @@index([reviewedBy])
  @@map("payments")
}

model Delivery {
  id                       BigInt         @id @default(autoincrement())
  bookingId                BigInt         @unique @map("booking_id")
  method                   DeliveryMethod
  providerName             String?        @map("provider_name") @db.VarChar(120)
  trackingNumber           String?        @map("tracking_number") @db.VarChar(120)
  shippedAt                DateTime?      @map("shipped_at") @db.Timestamptz
  readyForPickupAt         DateTime?      @map("ready_for_pickup_at") @db.Timestamptz
  ownerHandoverConfirmedAt DateTime?      @map("owner_handover_confirmed_at") @db.Timestamptz
  renterReceivedAt         DateTime?      @map("renter_received_at") @db.Timestamptz
  evidenceUrl              String?        @map("evidence_url")
  evidencePublicId         String?        @map("evidence_public_id")
  note                     String?
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("deliveries")
}

model RentalReturn {
  id                     BigInt          @id @default(autoincrement())
  bookingId              BigInt          @unique @map("booking_id")
  status                 ReturnStatus    @default(pending)
  returnMethod           DeliveryMethod? @map("return_method")
  returnProviderName     String?         @map("return_provider_name") @db.VarChar(120)
  returnTrackingNumber   String?         @map("return_tracking_number") @db.VarChar(120)
  returnNote             String?         @map("return_note")
  returnEvidenceUrl      String?         @map("return_evidence_url")
  returnEvidencePublicId String?         @map("return_evidence_public_id")
  renterReturnedAt       DateTime?       @map("renter_returned_at") @db.Timestamptz
  ownerReceivedAt        DateTime?       @map("owner_received_at") @db.Timestamptz
  damageDescription      String?         @map("damage_description")
  damageEvidenceUrl      String?         @map("damage_evidence_url")
  damageEvidencePublicId String?         @map("damage_evidence_public_id")
  damageAmount           Decimal         @default(0) @map("damage_amount") @db.Decimal(12, 2)
  approvedDamageAmount   Decimal?        @map("approved_damage_amount") @db.Decimal(12, 2)
  renterDisputeReason    String?         @map("renter_dispute_reason")
  adminDecision          String?         @map("admin_decision")
  adminDecisionNote      String?         @map("admin_decision_note")
  reviewedBy             BigInt?         @map("reviewed_by")
  reviewedAt             DateTime?       @map("reviewed_at") @db.Timestamptz
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User?   @relation("RentalReturnReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([reviewedBy])
  @@map("rental_returns")
}

model Wallet {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @unique @map("user_id")
  simulatedBalance Decimal  @default(0) @map("simulated_balance") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        User          @relation(fields: [userId], references: [id])
  entries     WalletEntry[]
  withdrawals Withdrawal[]

  @@map("wallets")
}

model WalletEntry {
  id          BigInt          @id @default(autoincrement())
  walletId    BigInt          @map("wallet_id")
  bookingId   BigInt?         @map("booking_id")
  entryType   WalletEntryType @map("entry_type")
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  wallet  Wallet   @relation(fields: [walletId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([walletId])
  @@index([bookingId])
  @@index([entryType])
  @@map("wallet_entries")
}

model BankAccount {
  id                     BigInt   @id @default(autoincrement())
  userId                 BigInt   @map("user_id")
  bankId                 BigInt?  @map("bank_id")
  bankName               String   @map("bank_name") @db.VarChar(120)
  accountName            String   @map("account_name") @db.VarChar(160)
  accountNumberEncrypted String   @map("account_number_encrypted")
  accountNumberLast4     String   @map("account_number_last4") @db.VarChar(4)
  accountNumberMasked    String   @map("account_number_masked") @db.VarChar(40)
  isDefault              Boolean  @default(false) @map("is_default")
  verifiedByAdmin        Boolean  @default(false) @map("verified_by_admin")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        User         @relation(fields: [userId], references: [id])
  bank        Bank?        @relation(fields: [bankId], references: [id])
  withdrawals Withdrawal[]

  @@index([userId])
  @@index([bankId])
  @@index([isDefault])
  @@map("bank_accounts")
}

model Bank {
  id           BigInt   @id @default(autoincrement())
  code         String   @unique @db.VarChar(20)
  abbreviation String   @unique @db.VarChar(30)
  name         String   @db.VarChar(160)
  logoUrl      String?  @map("logo_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  bankAccounts            BankAccount[]
  platformSettings        PlatformSetting[]
  platformPaymentAccounts PlatformPaymentAccount[]

  @@index([name])
  @@index([isActive])
  @@map("banks")
}

model PlatformSetting {
  id                      Int      @id @default(1)
  platformFee             Decimal  @default(10) @map("platform_fee") @db.Decimal(5, 2)
  minPayout               Decimal  @default(500) @map("min_payout") @db.Decimal(12, 2)
  lateFeePerDay           Decimal  @default(300) @map("late_fee_per_day") @db.Decimal(12, 2)
  minAdvanceDays          Int      @default(5) @map("min_advance_days")
  paymentDeadlineHours    Int      @default(24) @map("payment_deadline_hours")
  ownerPrepDays           Int      @default(2) @map("owner_prep_days")
  cancellationWindowHours Int      @default(12) @map("cancellation_window_hours")
  platformBankId          BigInt?  @map("platform_bank_id")
  platformAccountName     String   @default("GlowFrame Co., Ltd.") @map("platform_account_name") @db.VarChar(160)
  platformAccountNo       String   @default("123-4-56789-0") @map("platform_account_no") @db.VarChar(80)
  paymentReviewHours      Int      @default(24) @map("payment_review_hours")
  payoutReviewDays        Int      @default(3) @map("payout_review_days")
  supportedBanks          String   @default("") @map("supported_banks")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  platformBank    Bank?                    @relation(fields: [platformBankId], references: [id], onDelete: SetNull)
  paymentAccounts PlatformPaymentAccount[]

  @@index([platformBankId])
  @@map("platform_settings")
}

model PlatformPaymentAccount {
  id            BigInt   @id @default(autoincrement())
  settingId     Int      @map("setting_id")
  bankId        BigInt   @map("bank_id")
  accountName   String   @map("account_name") @db.VarChar(160)
  accountNumber String   @map("account_number") @db.VarChar(80)
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  setting  PlatformSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  bank     Bank            @relation(fields: [bankId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([settingId, isActive, sortOrder])
  @@index([bankId])
  @@map("platform_payment_accounts")
}

model Withdrawal {
  id              BigInt           @id @default(autoincrement())
  userId          BigInt           @map("user_id")
  walletId        BigInt           @map("wallet_id")
  bankAccountId   BigInt           @map("bank_account_id")
  amount          Decimal          @db.Decimal(12, 2)
  status          WithdrawalStatus @default(pending)
  rejectionReason String?          @map("rejection_reason")
  reviewedBy      BigInt?          @map("reviewed_by")
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user        User        @relation("WithdrawalUser", fields: [userId], references: [id])
  wallet      Wallet      @relation(fields: [walletId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  reviewer    User?       @relation("WithdrawalReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@map("withdrawals")
}

model Review {
  id         BigInt   @id @default(autoincrement())
  bookingId  BigInt   @unique @map("booking_id")
  productId  BigInt   @map("product_id")
  reviewerId BigInt   @map("reviewer_id")
  rating     Int
  comment    String?
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking  Booking @relation(fields: [bookingId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
  reviewer User    @relation(fields: [reviewerId], references: [id])

  @@index([productId])
  @@index([reviewerId])
  @@index([isHidden])
  @@map("reviews")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  title     String    @db.VarChar(160)
  body      String?
  linkUrl   String?   @map("link_url")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

model PolicyDocument {
  id             BigInt               @id @default(autoincrement())
  type           PolicyDocumentType
  titleTh        String               @map("title_th") @db.VarChar(160)
  titleEn        String               @map("title_en") @db.VarChar(160)
  version        String               @db.VarChar(40)
  bodyTh         String               @map("body_th")
  bodyEn         String               @map("body_en")
  isRequired     Boolean              @default(true) @map("is_required")
  status         PolicyDocumentStatus @default(draft)
  forceReconsent Boolean              @default(false) @map("force_reconsent")
  effectiveAt    DateTime?            @map("effective_at") @db.Timestamptz
  publishedAt    DateTime?            @map("published_at") @db.Timestamptz
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  acceptances UserPolicyAcceptance[]

  @@unique([type, version])
  @@index([type])
  @@index([status])
  @@index([isRequired])
  @@map("policy_documents")
}

model UserPolicyAcceptance {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @map("user_id")
  policyDocumentId BigInt   @map("policy_document_id")
  acceptedVersion  String   @map("accepted_version") @db.VarChar(40)
  acceptedAt       DateTime @default(now()) @map("accepted_at") @db.Timestamptz
  ipAddress        String?  @map("ip_address") @db.VarChar(80)
  userAgent        String?  @map("user_agent")

  user           User           @relation(fields: [userId], references: [id])
  policyDocument PolicyDocument @relation(fields: [policyDocumentId], references: [id])

  @@unique([userId, policyDocumentId])
  @@index([userId])
  @@index([policyDocumentId])
  @@map("user_policy_acceptances")
}
